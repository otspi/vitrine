# ==============================================================================
# OTSPI — Configuration Apache / Infomaniak (.htaccess) — www.otspi.org
# ==============================================================================

# 1. HTTPS obligatoire et domaine canonique www.otspi.org
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Tout domaine autre que www.otspi.org (otspi.org, otspi.com, otspi.eu,
  # otspi.fr et leurs variantes www) redirige vers l'adresse canonique
  RewriteCond %{HTTP_HOST} !^www\.otspi\.org$ [NC]
  RewriteRule ^(.*)$ https://www.otspi.org/$1 [L,R=301]

  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://www.otspi.org%{REQUEST_URI} [L,R=301]

  # Adresses courtes, faciles à citer de vive voix
  RewriteRule ^manifeste/$ https://www.otspi.org/manifeste [L,R=301]
  RewriteRule ^en/manifesto/$ https://www.otspi.org/en/manifesto [L,R=301]
  RewriteRule ^manifeste$ /manifeste.html [L]
  RewriteRule ^en/manifesto$ /en/manifesto.html [L]
</IfModule>

# 2. En-têtes de sécurité
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Aucune ressource externe ; seul le script en ligne d'amorçage est autorisé par son empreinte
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw='; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
</IfModule>

# 3. Types MIME
<IfModule mod_mime.c>
  AddType image/svg+xml .svg .svgz
  AddEncoding gzip .svgz
</IfModule>

# 4. Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript text/javascript image/svg+xml
</IfModule>

# 5. Cache navigateur
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
</IfModule>

# Types des fichiers XML
<FilesMatch "^feed\.xml$">
  ForceType application/atom+xml
</FilesMatch>
<FilesMatch "^sitemap\.xml$">
  ForceType application/xml
</FilesMatch>

# 6. Page d'erreur personnalisée
ErrorDocument 404 /404.html

# 7. Pas de listage des répertoires ni d'accès aux métadonnées de dépôt
Options -Indexes
RedirectMatch 404 (^|/)\.(git|github)(/|$)
